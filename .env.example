# Keep the MVP in simulated x402 mode until compliance, settlement, refund,
# sanctions/KYT, and source-rights review are complete.
AOE_PAYMENT_MODE=simulated
AOE_PORT=4402
AOE_PUBLIC_BASE_URL=http://127.0.0.1:4402
AOE_TESTNET_NETWORK=eip155:84532
AOE_TESTNET_ASSET=USDC
AOE_SIMULATED_PAY_TO=0x000000000000000000000000000000000000dEaD

# Official x402 testnet mode. Generate local burner values with:
# npm run x402:burner -- --write-env
# Then run with the generated ignored .env.x402.local values loaded locally.
AOE_X402_NETWORK=eip155:84532
AOE_X402_FACILITATOR_URL=https://x402.org/facilitator
# AOE_PAYMENT_MODE=x402_testnet
# AOE_X402_PAY_TO=0xYourBaseSepoliaBurnerReceiver
# AOE_BUYER_EVM_PRIVATE_KEY=0xYourBuyerBurnerPrivateKey
# AOE_X402_CLIENT_MAX_USD=1.00
