{
  "name": "agent-opportunity-exchange",
  "version": "0.1.0",
  "private": true,
  "description": "Rights-cleared x402-ready intelligence products for agents, builders, operators, and regional/cyber/market workflows.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "x402:burner": "tsx scripts/create-burner-wallet.ts",
    "x402:testnet:fetch": "tsx scripts/x402-testnet-fetch.ts",
    "market:quality": "tsx scripts/market-stream-quality.ts",
    "sellability": "tsx scripts/sellability-scorecard.ts",
    "cyber:priority": "tsx src/cli/cyber-priority.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "boundary": "node scripts/check-boundaries.mjs",
    "verify": "npm run boundary && npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@x402/core": "^2.11.0",
    "@x402/evm": "^2.11.0",
    "@x402/fetch": "^2.11.0",
    "@x402/hono": "^2.11.0",
    "hono": "^4.12.18",
    "viem": "^2.48.11",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
